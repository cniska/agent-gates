{
  "name": "agent-gates",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-gates": "./bin/agent-gates"
  },
  "scripts": {
    "format": "bunx biome check --write src acceptance scripts",
    "lint": "bunx biome check --error-on-warnings src acceptance scripts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "acceptance": "bun test --timeout 20000 ./acceptance/*.acceptance.ts",
    "knip": "bunx --bun knip",
    "check": "bun run lint && bun run typecheck && bun run knip && bun test",
    "gates:bundle": "bun src/gate-bundles.ts",
    "prepare": "! git rev-parse --git-dir >/dev/null 2>&1 || git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "knip": "6.39.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
